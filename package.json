{
  "name": "cogentrex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @cogentrex/shared build && pnpm --parallel --filter @cogentrex/api --filter @cogentrex/web dev",
    "build": "pnpm -r --if-present run build",
    "start:api": "pnpm --filter @cogentrex/api start",
    "start:web": "pnpm --filter @cogentrex/web start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm --filter @cogentrex/shared build && pnpm -r --if-present run test",
    "test:api": "pnpm --filter @cogentrex/api test",
    "db:reset": "rm -f data/cogentrex.sqlite data/cogentrex.sqlite-*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12",
      "postcss": "^8.5.10",
      "vite": "^6.4.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  }
}
